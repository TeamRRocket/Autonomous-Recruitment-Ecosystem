# AI Service Environment Variables

# LLM Configuration
# ==================
# Choose which LLM to use:
# - USE_LOCAL_MODEL=true  -> Uses Ollama with local Mistral
# - USE_LOCAL_MODEL=false -> Uses OpenRouter with Claude 3.5 Sonnet

USE_LOCAL_MODEL=true
LOCAL_MODEL=mistral
OLLAMA_URL=http://localhost:11434/api/chat

# OpenRouter API Key (only needed if USE_LOCAL_MODEL=false)
OPENROUTER_API_KEY=your_openrouter_api_key_here
